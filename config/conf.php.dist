/* CONFIG START. DO NOT CHANGE ANYTHING IN OR AFTER THIS LINE. */
// $Hash: a246586cf9f8ff4880ca09084af67d8114fa6eb1
// $Id$

// Display a list of mail servers for users to choose from: 'none', 'shown', or 'hidden'
$conf['server']['server_list'] = 'shown';

// Send attachments as web-accessible download links instead of inline MIME parts
$conf['compose']['link_attachments'] = false;
// Maximum total size of attachments per message in bytes (0 = no limit)
$conf['compose']['attach_size_limit'] = 0;
// Maximum number of attachments per message (0 = no limit)
$conf['compose']['attach_count_limit'] = 0;
// Maximum size of quoted text in bytes when replying/forwarding (0 = no limit)
$conf['compose']['reply_limit'] = 200000;
// Minimum characters typed before address autocompletion triggers
$conf['compose']['ac_threshold'] = 3;
// Maximum cumulative size of embedded images in HTML signatures in bytes (0 = no limit, not recommended)
$conf['compose']['htmlsig_img_size'] = 30000;
// Add a Received header exposing that Horde received the mail via HTTPS and the client IP
$conf['compose']['add_received_header'] = true;

// RSA key length for PGP keypair generation in bits (0 = disable generation)
$conf['pgp']['keylength'] = 0;

// Use legacy maillog-based MDN tracking instead of IMAP server flags (pre-IMP 6.0 compat)
$conf['maillog']['mdn_history'] = false;
// Backend driver for tracking forwarded/replied/redirected message history: 'none' or 'history'
$conf['maillog']['driver'] = 'history';

// Days to retain sent-mail log entries before purging
$conf['sentmail']['params']['threshold'] = 60;
// Time period in hours for per-user recipient rate limiting
$conf['sentmail']['params']['limit_period'] = 24;
// Database table name for the SQL sentmail driver
$conf['sentmail']['params']['table'] = 'imp_sentmail';
// Database connection: 'horde' uses the global Horde DB config
$conf['sentmail']['params']['driverconfig'] = 'horde';
// Sentmail log storage driver: 'Null', 'Sql', or 'Nosql'
$conf['sentmail']['driver'] = 'Sql';

// Backends to query for contact avatar images (Addressbook, Gravatar, Unknown, Flag_Host)
$conf['contactsimage']['backends'] = array('IMP_Contacts_Avatar_Addressbook');

// Enable creating Nag tasks from mail messages (adds server load for task category listing)
$conf['tasklist']['use_tasklist'] = true;
// Enable creating Mnemo notes from mail messages (adds server load for note category listing)
$conf['notepad']['use_notepad'] = true;
/* CONFIG END. DO NOT CHANGE ANYTHING IN OR BEFORE THIS LINE. */
